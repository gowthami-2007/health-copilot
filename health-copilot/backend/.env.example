# ==============================================================================
# HealthCopilot Backend Environment Configuration Template (.env.example)
# Use placeholders only. NEVER commit real secrets or credentials to git.
# ==============================================================================

# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local Instance)
MONGODB_URI=mongodb://127.0.0.1:27017/health_copilot

# Authentication & Session Secrets
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_characters
JWT_EXPIRES_IN=7d
SESSION_SECRET=your_session_secret_for_signing_cookies
OTP_SECRET=your_cryptographic_otp_pepper_salt_key

# Session Lifetimes & OTP Policy
# Persistent login ("Remember me"): 7 days (604800000 ms)
# Standard session: 24 hours (86400000 ms)
# OTP TTL: 5 minutes (300000 ms)
# OTP Resend Cooldown: 60 seconds
OTP_EXPIRES_MINUTES=5
OTP_COOLDOWN_SECONDS=60

# Frontend & Backend Origins (Configured for CORS & Secure HTTP-only cookies)
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001
# Production example:
# CLIENT_URL=https://health-copilot-pearl.vercel.app
# BACKEND_URL=https://health-copilot-pv0y.onrender.com

# Google OAuth 2.0 / OpenID Connect Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Delivery Configuration (Real Transactional Email Delivery)
# Option A: Resend REST API (Recommended transactional provider, starts with re_)
EMAIL_PROVIDER_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=HealthCopilot <notifications@yourverifieddomain.com>

# Option B: Standard SMTP Credentials (Nodemailer fallback)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your_smtp_password_or_api_key

# AI / LLM Service Configuration (Gemini 2.5 Flash / Flash Lite)
AI_SERVICE_PORT=5002
AI_SERVICE_URL=http://localhost:5002
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-flash-lite-latest
AI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai

# Document Processing & Local Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
