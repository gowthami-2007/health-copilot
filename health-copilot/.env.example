# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/health_copilot

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Client and Server URLs
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001

# Google OAuth 2.0 / OpenID Connect Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Email Delivery Configuration (Resend, SendGrid, or Custom SMTP)
# Option A: Resend API (recommended, starts with re_)
EMAIL_PROVIDER_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=HealthCopilot <notifications@yourverifieddomain.com>

# Option B: Standard SMTP Credentials (Optional alternative)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your_smtp_password_or_api_key

# AI / LLM Service Configuration
AI_SERVICE_PORT=5002
AI_SERVICE_URL=http://localhost:5002
AI_API_KEY=your_gemini_or_openai_api_key
AI_MODEL=gemini-flash-lite-latest
AI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai

# Document Processing & Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Cloudinary (Optional for cloud storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
