# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/health_copilot

# Authentication Secrets
JWT_SECRET=health_copilot_super_secure_jwt_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Client URL
CLIENT_URL=http://localhost:5173

# AI Service Configuration
AI_SERVICE_PORT=5001
AI_SERVICE_URL=http://localhost:5001
AI_API_KEY=your_openai_or_groq_or_gemini_api_key_here
AI_MODEL=gpt-4o-mini
AI_API_BASE=https://api.openai.com/v1

# Document Processing & Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Cloudinary (Optional for cloud storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
